# Mission MMA Website — environment variables
# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored and never committed.
#
# For Vercel production: add these same variables under
# Project Settings → Environment Variables.

# ─────────────────────────────────────────────────────────
# n8n webhook for lead form submissions
# Server-only (no NEXT_PUBLIC prefix). The URL must NEVER appear in client JS.
# Get a fresh URL from your n8n workflow's webhook node.
# ─────────────────────────────────────────────────────────
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/REPLACE-ME

# ─────────────────────────────────────────────────────────
# Site URL — used for canonical URLs, sitemap.xml, OG tags
# Use http://localhost:3000 for local dev, the production domain for prod.
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────
# Meta (Facebook) Pixel ID — for ad attribution and audience tracking
# Inherited from the existing missionmmachicago.com site to preserve audience continuity.
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=643275415764341

# ─────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID — leave empty until GA4 property exists
# When set, the script in app/layout.tsx will fire pageview events.
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=

# ─────────────────────────────────────────────────────────
# n8n webhook for /book calendar form submissions (client-side POST)
# Use a webhook.site URL for local testing. Set real n8n URL in production.
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_N8N_BOOKING_URL=https://webhook.site/YOUR-BOOKING-UUID
